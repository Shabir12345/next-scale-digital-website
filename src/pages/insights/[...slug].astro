---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const path = `/insights/${post.id}/`;
const pageUrl = new URL(path, site.url).href;

const others = (await getCollection('insights', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .slice(0, 2);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Insights', href: '/insights/' },
  { name: post.data.title, href: path },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });

const toc = headings.filter((h) => h.depth === 2);
---

<Base
  title={post.data.metaTitle ?? `${post.data.title} | Next Scale Digital`}
  description={post.data.description}
  path={path}
  ogType="article"
  publishedTime={post.data.published.toISOString()}
  modifiedTime={(post.data.updated ?? post.data.published).toISOString()}
  breadcrumbs={breadcrumbs}
>
  <article>
    <header class="phero">
      <div class="wrap-tight">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/insights/">Insights</a></li>
          </ol>
        </nav>
        <h1>{post.data.title}</h1>
        <p class="art-meta">
          <time datetime={post.data.published.toISOString()}>{fmt(post.data.published)}</time>
          <span class="num">{post.data.readingMinutes} min read</span>
        </p>
      </div>
    </header>

    <div class="wrap art-shell">
      {toc.length > 2 && (
        <aside class="toc">
          <span class="toc-k">On this page</span>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </aside>
      )}

      <div class="art">
        <Content />
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="section-sm section-mist">
      <div class="wrap">
        <span class="eyebrow">Keep reading</span>
        <div class="more">
          {others.map((o) => (
            <a class="more-card" href={`/insights/${o.id}/`}>
              <h2>{o.data.title}</h2>
              <p>{o.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA />
</Base>

<style>
  .phero { background: var(--ink); color: var(--fg-on-ink); padding-block: var(--sp-6) var(--sp-8); }
  .phero h1 { color: var(--paper); font-size: var(--step-4); max-width: 24ch; }

  .crumbs { margin-bottom: var(--sp-5); }
  .crumbs ol {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.74rem; color: var(--fg-faint);
  }
  .crumbs li + li::before { content: "/"; margin-right: 0.5rem; color: var(--rule-dark); }
  .crumbs a { color: var(--fg-on-ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--brand-lite); }

  .art-meta {
    display: flex; gap: var(--sp-5); align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin: 0;
  }

  .art-shell {
    display: grid;
    gap: var(--sp-7);
    padding-block: var(--sp-8);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .art-shell { grid-template-columns: 15rem minmax(0, 1fr); gap: var(--sp-8); }
    .toc { position: sticky; top: 6rem; }
  }

  .toc { border-left: 1px solid var(--rule); padding-left: var(--sp-4); }
  .toc-k {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: var(--sp-3);
  }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .toc a { font-size: 0.86rem; color: var(--fg-muted); text-decoration: none; line-height: 1.4; display: block; }
  .toc a:hover { color: var(--brand); }

  .art { max-width: 70ch; }
  .art :global(h2) {
    font-size: var(--step-2);
    margin-top: var(--sp-7);
    margin-bottom: var(--sp-4);
    scroll-margin-top: 5.5rem;
  }
  .art :global(h2:first-child) { margin-top: 0; }
  .art :global(h3) { font-size: var(--step-1); margin-top: var(--sp-6); margin-bottom: var(--sp-3); }
  .art :global(p) { margin-bottom: var(--sp-4); }
  .art :global(ul), .art :global(ol) { margin: 0 0 var(--sp-5); padding-left: 1.3rem; display: grid; gap: 0.6rem; }
  .art :global(li) { padding-left: 0.2rem; }
  .art :global(strong) { font-weight: 600; }
  .art :global(blockquote) {
    margin: var(--sp-5) 0;
    padding: var(--sp-4) var(--sp-5);
    background: var(--mist);
    border-radius: var(--radius);
    font-size: 0.96rem;
  }
  .art :global(blockquote p:last-child) { margin-bottom: 0; }

  .more {
    display: grid; gap: var(--sp-4); margin-top: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .more-card {
    display: block; background: var(--paper);
    border: 1px solid var(--rule); border-radius: var(--radius-lg);
    padding: var(--sp-5); text-decoration: none; color: inherit;
    transition: border-color 150ms ease;
  }
  .more-card:hover { border-color: var(--brand); color: inherit; }
  .more-card h2 { font-size: 1.06rem; margin-bottom: var(--sp-2); }
  .more-card p { margin: 0; font-size: 0.9rem; color: var(--fg-muted); }
</style>
