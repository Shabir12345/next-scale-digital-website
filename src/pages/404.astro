---
import Base from '../layouts/Base.astro';
import { services, site } from '../data/site';
import { industries } from '../data/industries';
---

<Base
  title="Page not found | Next Scale Digital"
  description="That page does not exist. Here is where everything else lives."
  path="/404/"
  noindex={true}
>
  <section class="nf">
    <div class="wrap-tight">
      <span class="eyebrow">404</span>
      <h1>That page is not here</h1>
      <p class="lede">
        The link is wrong, or the page has moved. Everything on the site is listed
        below, or email <a href={`mailto:${site.email}`}>{site.email}</a> and we will
        point you at it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap nf-grid">
      <div>
        <h2>Services</h2>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Industries</h2>
        <ul>
          {industries.map((i) => <li><a href={`/industries/${i.slug}/`}>{i.nav}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Elsewhere</h2>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/work/">Work</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact and free audit</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { background: var(--ink); color: var(--fg-on-ink); padding-block: var(--sp-8); }
  .nf .eyebrow { color: var(--brand-lite); }
  .nf .eyebrow::after { background: var(--rule-dark); }
  .nf h1 { color: var(--paper); font-size: var(--step-4); }
  .nf .lede { color: var(--fg-on-ink-muted); }
  .nf a { color: var(--brand-lite); }

  .nf-grid { display: grid; gap: var(--sp-6); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .nf-grid h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: var(--sp-4);
  }
  .nf-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .nf-grid a { text-decoration: none; }
  .nf-grid a:hover { text-decoration: underline; }
</style>
