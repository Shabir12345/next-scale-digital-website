---
export interface Props {
  heading?: string;
  body?: string;
  action?: string;
  href?: string;
}
const {
  heading = 'Find out where you actually rank',
  body = 'A free audit checks your map position from every corner of your service area, your site’s technical health, and what your three closest competitors are doing differently. No obligation, and you keep the report either way.',
  action = 'Get my free audit',
  href = '/contact/',
} = Astro.props;
---
<section class="cta-band">
  <div class="wrap cta-in">
    <div>
      <h2>{heading}</h2>
      <p class="lede">{body}</p>
    </div>
    <div class="cta-act">
      <a href={href} class="btn btn-primary">{action}</a>
      <p class="cta-note">Usually back within two business days.</p>
    </div>
  </div>
</section>

<style>
  .cta-band { background: var(--ink); color: var(--fg-on-ink); padding-block: var(--sp-8); }
  .cta-in { display: grid; gap: var(--sp-6); align-items: center; }
  .cta-in h2 { color: var(--paper); font-size: var(--step-3); margin-bottom: var(--sp-3); }
  .cta-in .lede { color: var(--fg-on-ink-muted); font-size: var(--step-0); }
  .cta-act { display: grid; gap: var(--sp-3); justify-items: start; }
  .cta-note { font-size: 0.84rem; color: var(--fg-faint); margin: 0; }
  @media (min-width: 860px) {
    .cta-in { grid-template-columns: 1.5fr auto; gap: var(--sp-8); }
    .cta-act { justify-items: end; text-align: right; }
  }
</style>
